DATABASE_URL="postgresql://"

API_URL=
NEXT_PUBLIC_API_URL=

# S3-compatible storage (Beget). Server-side credentials — never expose to the
# client. The bucket policy must allow public GET for product images.
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_HOST=https://s3.ru1.storage.beget.cloud/
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Public S3 image URLs (no secrets). Stored product image values (S3 object
# keys) are normalized to:
# <NEXT_PUBLIC_S3_PUBLIC_URL>/<NEXT_PUBLIC_S3_PRODUCT_PREFIX>/<key segments>
NEXT_PUBLIC_S3_PUBLIC_URL=https://s3.ru1.storage.beget.cloud/5427be431039-dev
NEXT_PUBLIC_S3_BUCKET=5427be431039-dev
NEXT_PUBLIC_S3_PRODUCT_PREFIX=products
# User avatar uploads (S3 object keys under this prefix + user id segments).
# Stored avatar keys are normalized to:
# <NEXT_PUBLIC_S3_PUBLIC_URL>/<NEXT_PUBLIC_S3_AVATAR_PREFIX>/<userId>/<uuid>.<ext>
NEXT_PUBLIC_S3_AVATAR_PREFIX=users/icons